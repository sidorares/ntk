{
  "name": "ntk",
  "version": "8.23.2",
  "description": "Desktop UI toolkit for X11 with canvas-like 2d and OpenGL rendering",
  "author": "Andrey Sidorov <sidorares@yandex.ru>",
  "license": "MIT",
  "keywords": [
    "ui",
    "gui",
    "widgets",
    "desktop",
    "x11",
    "canvas",
    "xrender"
  ],
  "homepage": "https://github.com/sidorares/ntk",
  "bugs": {
    "url": "https://github.com/sidorares/ntk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidorares/ntk.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./xembed": "./lib/xembed.js",
    "./color": "./lib/color.js",
    "./imagedata": "./lib/imagedata.js",
    "./path": "./lib/path.js",
    "./gl": "./lib/gl.js",
    "./shadow-math": "./lib/shadowmath.js",
    "./shadow-tiles": "./lib/shadowtiles.js",
    "./image": "./lib/image.js",
    "./svg": "./lib/widgets/svgview.js",
    "./font": "./lib/text/font.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.12",
    "bidi-js": "^1.0.3",
    "brotli": "^1.3.2",
    "clone": "^2.1.2",
    "dfa": "^1.2.0",
    "domutils": "^4.0.2",
    "extrude-polyline": "^1.0.6",
    "fast-deep-equal": "^3.1.3",
    "htmlparser2": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "linebreak": "^1.1.0",
    "parse-color": "^1.0.0",
    "pngjs": "^7.0.0",
    "restructure": "^3.0.0",
    "tiny-inflate": "^1.0.3",
    "unicode-properties": "^1.4.0",
    "unicode-trie": "^2.0.0",
    "x11": "^4.1.0"
  },
  "optionalDependencies": {
    "x11-dri": ">=0.5.0 <1"
